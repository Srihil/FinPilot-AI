# FinPilot AI - Environment Variables
# Copy this file to .env and fill in your values

# ============================================================
# DATABASE
# ============================================================
DATABASE_URL=postgresql://finpilot:finpilot_password@localhost:5432/finpilot_db

# ============================================================
# SECURITY
# ============================================================
JWT_SECRET=your-super-secret-jwt-key-change-in-production-minimum-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ============================================================
# CORS
# ============================================================
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ============================================================
# AI CONFIGURATION
# ============================================================
# Provider: openrouter | ollama | demo
AI_PROVIDER=demo
AI_MODEL=mistralai/mistral-7b-instruct:free

# OpenRouter (free models available at openrouter.ai)
OPENROUTER_API_KEY=

# Groq (fast inference, free tier at console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Ollama (local, completely free)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ============================================================
# APPLICATION
# ============================================================
APP_NAME=FinPilot AI
APP_ENV=development
# Set to true to enable demo mode regardless of AI_PROVIDER
DEMO_MODE=true

# ============================================================
# FILE UPLOADS
# ============================================================
MAX_UPLOAD_SIZE_MB=10
UPLOAD_DIR=./uploads

# ============================================================
# TALLY INTEGRATION (optional)
# ============================================================
TALLY_ENABLED=false
TALLY_HOST=localhost
TALLY_PORT=9000

# ============================================================
# RENDER DEPLOYMENT (set these on Render dashboard)
# ============================================================
# PORT=8000
# FRONTEND_URL=https://your-app.onrender.com
