# FinPilot Tally Connector — Configuration
# Copy this file to .env and fill in the values.

# URL of your FinPilot backend on Render (no trailing slash)
FINPILOT_API_URL=https://finpilot-backend-vbdf.onrender.com

# Connector authentication token (set automatically after pairing)
# DO NOT share this token — treat it like a password
CONNECTOR_TOKEN=

# TallyPrime server (default: local HTTP server on same machine)
TALLY_HOST=localhost
TALLY_PORT=9000

# How often (seconds) to poll the cloud for new jobs
POLL_INTERVAL_SECONDS=10

# How often (seconds) to send a heartbeat to the cloud
HEARTBEAT_INTERVAL_SECONDS=30

# Logging verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
